# Application
NODE_ENV=development
PORT=5000
APP_NAME=Uniquworld
APP_URL=https://uniquworld-server.onrender.com
CLIENT_URL=https://uniquworld.com
API_PREFIX=/api/v1

# Supabase PostgreSQL
# Render has no IPv6 — do NOT use db.[ref].supabase.co (AAAA only → ENETUNREACH).
# Use Dashboard → Connect → Connection pooling (Transaction, port 6543).
# User must be postgres.[PROJECT-REF]
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_SSL=true

# Supabase Project (new API keys)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=uniquworld-assets

# Legacy keys (optional fallbacks)
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Email — Resend recommended for Primary inbox (Gmail SMTP often → Spam)
# 1) Create account at https://resend.com
# 2) Domains → add uniquworld.com (or mail.uniquworld.com) → add DNS SPF/DKIM → Verify
# 3) API Keys → create key → paste below
# 4) Set FROM to an address on that verified domain
RESEND_API_KEY=
SMTP_FROM_NAME=Uniquworld
SMTP_FROM_EMAIL=admin@uniquworld.com
# Public HTTPS logo for email header (Gmail requires absolute URL)
EMAIL_LOGO_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/uniquworld-assets/brand/Uniquworld.jpg

# Fallback SMTP (Gmail) — frequently lands in Spam; use only for local smoke tests
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google OAuth (ready for client integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay — use Techackode (or any) merchant keys for settlement.
# Checkout UI always shows Uniquworld via RAZORPAY_DISPLAY_NAME / logo below.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_DISPLAY_NAME=Uniquworld
# Public HTTPS logo (falls back to EMAIL_LOGO_URL)
RAZORPAY_LOGO_URL=
RAZORPAY_THEME_COLOR=#4a3426

# Shiprocket
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=your-shiprocket-login@email.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Commerce
COMMERCE_CURRENCY=INR
DEFAULT_SHIPPING_AMOUNT=49
FREE_SHIPPING_MIN=999
COD_ENABLED=true
PLATFORM_FEE_FLAT=5
# Store partner fee: charged to customer on top of product price (owner still receives full product amount)
STORE_PLATFORM_FEE_PERCENT=0.1

# CORS
CORS_ORIGINS=https://uniquworld.com,https://www.uniquworld.com,http://localhost:5173,http://localhost:3000

ADMIN_API_KEY=uniquworld-admin-dev-key
