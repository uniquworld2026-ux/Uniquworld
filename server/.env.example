# Application
NODE_ENV=development
PORT=5000
APP_NAME=Uniquworld
APP_URL=https://uniquworld-server.onrender.com
CLIENT_URL=https://uniquworld.com
API_PREFIX=/api/v1

# Supabase PostgreSQL
# Render has no IPv6 — do NOT use db.[ref].supabase.co (AAAA only → ENETUNREACH).
# Use Dashboard → Connect → Connection pooling (Transaction, port 6543).
# User must be postgres.[PROJECT-REF]
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_SSL=true

# Supabase Project (new API keys)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=uniquworld-assets

# Legacy keys (optional fallbacks)
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Uniquworld
SMTP_FROM_EMAIL=noreply@uniquworld.com

# Google OAuth (ready for client integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shiprocket
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=your-shiprocket-login@email.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# Commerce
COMMERCE_CURRENCY=INR
DEFAULT_SHIPPING_AMOUNT=49
FREE_SHIPPING_MIN=999
COD_ENABLED=true

# CORS
CORS_ORIGINS=https://uniquworld.com,https://www.uniquworld.com,http://localhost:5173,http://localhost:3000

ADMIN_API_KEY=uniquworld-admin-dev-key
